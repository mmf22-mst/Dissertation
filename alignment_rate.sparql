# =============================================================================
# alignment_rate.sparql
#
# Alignment-rate manipulation check for the dissertation's Factor B evaluation.
# Implements the four-category priority cascade defined in Part I §5.3 (v18):
#
#   1. Any cco: class (CCO namespace)  →  CCO-aligned
#   2. Any iof-constr: class           →  IOF-aligned
#   3. BFO_0000144 (process profile)   →  IOF-aligned  (carve-out)
#   4. Any other obo:BFO_ class        →  BFO-only-aligned
#   5. No upper-level ancestor          →  Unaligned
#
# BFO_0000144 carve-out:  This class has a BFO-namespace IRI but is
# contributed by both IOF and CCO (CCO curates it in the Event Ontology).
# In a B2b ontology, domain classes typically reach BFO_0000144 through
# CCO intermediates caught by rule 1.  The rare case where a domain class
# sits directly under BFO_0000144 with no cco: intermediate is absorbed
# into the IOF-aligned count and noted as a limitation.
#
# The query runs on the asserted rdfs:subClassOf hierarchy (no reasoner).
# It classifies every domain class in the ontology and produces both
# per-class results and summary counts.
#
# Domain classes are identified by exclusion: any named owl:Class whose
# IRI is not in the BFO namespace (obo:BFO_*), not in the IOF construct
# namespace (iof-constr:*), not in the CCO namespace (cco:*), and not
# owl:Thing or owl:Nothing.  This means the query works across all four
# conditions (B0, B1, B2a, B2b) without modification: in conditions that
# never imported a given vocabulary, no classes in that namespace exist
# to exclude.
#
# Contamination signal:
#   B0   BFO-aligned > 0  →  model used BFO IRIs from pre-training
#   B0   IOF-aligned > 0  →  model used IOF IRIs from pre-training
#   B0   CCO-aligned > 0  →  model used CCO IRIs from pre-training
#   B1   IOF-aligned > 0  →  model used IOF IRIs despite only receiving BFO
#   B1   CCO-aligned > 0  →  model used CCO IRIs despite only receiving BFO
#   B2a  CCO-aligned > 0  →  model used CCO IRIs despite only receiving IOF
#   B2a  BFO-only > 0     →  model bypassed IOF mid-level (expected, not contamination)
#   B2b  IOF-aligned > 0  →  model used IOF IRIs despite only receiving CCO
#   B2b  BFO-only > 0     →  model bypassed CCO mid-level (expected, not contamination)
#
# Pinned artefacts:
#   bfo-core.owl                    versionIRI http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl
#   Core.rdf                        versionIRI https://spec.industrialontologies.org/ontology/202603/core/Core/
#   CommonCoreOntologiesMerged.ttl  CCO v2.0 (2024-11-06)
#
# =============================================================================


# ---------------------------------------------------------------------------
# Query 1:  Per-class alignment classification
# ---------------------------------------------------------------------------

PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX obo:  <http://purl.obolibrary.org/obo/>
PREFIX iof:  <https://spec.industrialontologies.org/ontology/construct/>
PREFIX cco:  <https://www.commoncoreontologies.org/>

SELECT ?class (STR(?class) AS ?class_iri) ?alignment
WHERE {
    # ---- Identify domain classes ----
    # A domain class is any named owl:Class that is not an upper-level
    # or mid-level class and not owl:Thing / owl:Nothing.
    ?class a owl:Class .
    FILTER ( isIRI(?class) )
    FILTER ( ?class != owl:Thing && ?class != owl:Nothing )

    # Exclude BFO-namespace classes (upper-level, not domain)
    FILTER ( ! STRSTARTS(STR(?class), "http://purl.obolibrary.org/obo/BFO_") )

    # Exclude IOF-construct-namespace classes (mid-level, not domain)
    FILTER ( ! STRSTARTS(STR(?class), STR(iof:)) )

    # Exclude CCO-namespace classes (mid-level, not domain)
    FILTER ( ! STRSTARTS(STR(?class), STR(cco:)) )

    # ---- Priority cascade ----
    BIND (
        IF (
            # Priority 1: CCO-aligned
            # Ancestor is in the CCO namespace
            EXISTS {
                ?class rdfs:subClassOf+ ?ccoAnc .
                FILTER ( STRSTARTS(STR(?ccoAnc), STR(cco:)) )
            },
            "CCO-aligned",

            IF (
                # Priority 2–3: IOF-aligned
                # Ancestor is in the IOF construct namespace
                # OR ancestor is BFO_0000144 (contributed by both IOF and CCO,
                # but CCO intermediates are caught by priority 1 above)
                EXISTS {
                    ?class rdfs:subClassOf+ ?iofAnc .
                    FILTER (
                        STRSTARTS(STR(?iofAnc), STR(iof:))
                        || ?iofAnc = obo:BFO_0000144
                    )
                },
                "IOF-aligned",

                IF (
                    # Priority 4: BFO-only-aligned
                    # Ancestor is in BFO namespace (excluding BFO_0000144,
                    # already caught above)
                    EXISTS {
                        ?class rdfs:subClassOf+ ?bfoAnc .
                        FILTER (
                            STRSTARTS(STR(?bfoAnc), "http://purl.obolibrary.org/obo/BFO_")
                            && ?bfoAnc != obo:BFO_0000144
                        )
                    },
                    "BFO-only-aligned",

                    # Priority 5: Unaligned
                    "unaligned"
                )
            )
        )
        AS ?alignment
    )
}
ORDER BY ?alignment ?class


# ---------------------------------------------------------------------------
# Query 2:  Summary counts and rates
#
# Run separately (most SPARQL endpoints do not support multiple SELECT
# blocks in one request).  Save as alignment_rate_summary.sparql or
# split at the comment delimiter.
# ---------------------------------------------------------------------------
#
# PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
# PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
# PREFIX owl:  <http://www.w3.org/2002/07/owl#>
# PREFIX obo:  <http://purl.obolibrary.org/obo/>
# PREFIX iof:  <https://spec.industrialontologies.org/ontology/construct/>
# PREFIX cco:  <https://www.commoncoreontologies.org/>
#
